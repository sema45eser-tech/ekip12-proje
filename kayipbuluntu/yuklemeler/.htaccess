# Bu klasördeki dosyalar ASLA çalıştırılmamalı; yalnızca görüntülenmeli.
# Her sunucuda hata vermeden çalışacak şekilde yazılmıştır.

# PHP, Apache modülü olarak çalışıyorsa (XAMPP gibi) bu klasörde kapat.
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>

# Her durumda: çalıştırılabilir uzantılı dosyalara erişimi engelle.
<FilesMatch "\.(php|php[0-9]|phtml|phar|cgi|pl|py|sh)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
